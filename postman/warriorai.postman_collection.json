              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Messages By Conversation ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}", "messages"]
            }
          },
          "response": []
        },
        {
          "name": "Create Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) pm.collectionVariables.set('messageId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"USER\",\n  \"content\": \"Hello, can you help me write a message?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/message",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}", "message"]
            },
            "description": "Creates a message. Valid roles: `SYSTEM`, `USER`, `ASSISTANT`."
          },
          "response": []
        },
        {
          "name": "Ask AI In Conversation (SSE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Write a concise professional reply saying I will review this today.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/ask",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}", "ask"]
            },
            "description": "Streams SSE events: `delta`, `done`, or `error`. Also saves USER and ASSISTANT messages in the conversation."
          },
          "response": []
        }
      ]
    },

