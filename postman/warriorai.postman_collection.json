              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"title\": \"First conversation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["conversations"]
            },
            "description": "Creates a conversation and saves `conversationId`."
          },
          "response": []
        },
        {
          "name": "Get Conversation By ID",
          "request": {
            "method": "GET",
